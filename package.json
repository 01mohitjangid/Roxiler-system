{
  "name": "roxiler-store-ratings",
  "private": true,
  "engines": {
    "node": ">=22.9"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:setup": "npm run db:setup -w backend",
    "create-admin": "npm run create-admin -w backend",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "test": "npm test -w backend",
    "lint": "npm run lint --workspaces --if-present"
  }
}
